# Binance Testnet API 키 (실거래 키는 절대 여기 넣지 말 것)
BINANCE_API_KEY=your_testnet_api_key_here
BINANCE_API_SECRET=your_testnet_api_secret_here

# true = 테스트넷 사용 (기본값, 안전), false = 실거래
USE_TESTNET=true

# Claude API 키 (매매 의사결정용)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# 선물(BTC/USDT 10x 롱숏) 전용 — 실제 바이낸스 계정으로 로그인 후
# demo.binance.com/en/my/settings/api-management 에서 데모 트레이딩 키 발급 (현물 테스트넷과 다른 방식)
BINANCE_FUTURES_API_KEY=your_demo_trading_api_key_here
BINANCE_FUTURES_API_SECRET=your_demo_trading_api_secret_here

# 실계좌(진짜 자금) 전용 키 — binance.com 실제 계정의 API 관리에서 발급 (demo.binance.com 아님).
# 데모와 동시에 운영할 때만 필요. 비워두면 대시보드의 LIVE 전환이 400 에러로 명확히 알려준다.
BINANCE_FUTURES_LIVE_API_KEY=your_live_api_key_here
BINANCE_FUTURES_LIVE_API_SECRET=your_live_api_secret_here

LEVERAGE=10
MARGIN_MODE=isolated
STOP_LOSS_PCT=0.0125
# 거래당 리스크 — 마진 자산 대비. 코드 기본값은 0.02지만 2026-09-08 포트폴리오 시뮬레이션에서
# 낙폭이 과도한 것으로 확인돼(최대 -67%, 엣지 절반이면 -75%) 실운영은 0.0075로 낮춰 쓴다.
FUTURES_RISK_PER_TRADE=0.0075
# 동시에 열 수 있는 포지션 개수. 2026-09-09 포트폴리오 시뮬레이션에서 8이 정점
# (총R +185.0 / MDD -25.6%), 그 이상은 서킷브레이커가 너무 자주 걸려 오히려 나빠진다.
MAX_CONCURRENT_POSITIONS=8

# ATR이 손절폭의 이 배수 미만이면 진입하지 않는다(저변동 구간 차단). 0이면 필터 off.
MIN_ATR_TO_STOP_RATIO=0.64

# 상승 레짐(종가가 이 기간 SMA 위)에서 숏 진입을 막는다. 0이면 필터 off.
RULE_REGIME_SMA_PERIOD=400
# 현재가가 신호 봉 종가에서 손절폭의 몇 배까지 벗어나도 진입을 허용할지.
MAX_ENTRY_PRICE_DRIFT_R=0.5

# 텔레그램 알림/원격 시작·중지 (scripts/run_telegram_bot.py) — 없으면 이 기능만 비활성.
# 봇 토큰은 @BotFather에서, 채팅ID는 봇과 대화 시작 후 getUpdates로 확인(README 참고).
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here
# 프로세스는 살아있는데 사이클이 이 시간(초) 넘게 안 돌면 텔레그램으로 알린다(2026-09-09).
# POLL_INTERVAL_SECONDS의 배수로 넉넉히 — 일시적 지연에 울리면 진짜 경보를 무시하게 된다.
HEARTBEAT_STALE_SECONDS=600
# 하루 한 번 전날 성과를 텔레그램으로 보낼 로컬 시각(hour). -1이면 이 기능만 끈다.
TELEGRAM_DAILY_SUMMARY_HOUR=9
